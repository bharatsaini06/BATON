# ---- AI extraction (optional). Without a key Baton uses its offline rules engine.
# Set ONE of these. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional overrides
# AI_PROVIDER=gemini            # gemini | anthropic | openai | none
# AI_MODEL=gemini-2.5-flash     # any model name your provider offers
# AI_BASE_URL=https://api.groq.com/openai/v1   # for OpenAI-compatible providers (Groq, OpenRouter, local)
# AI_TIMEOUT_MS=45000

# ---- Durable share links on Vercel (optional, free tier): Upstash Redis REST
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.)

# ---- Round 3: accounts with Postgres Row-Level Security (Supabase). Run supabase/schema.sql first.
# Without these, Baton uses built-in accounts in the package store.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Signs share links and built-in sessions (40+ random characters). SHARE_LINK_SECRET also works.
# SESSION_SECRET=

# ---- Round 3: live connectors (see docs/CONNECTORS.md)
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---- GitHub import (optional): raises the API limit from 60 to 5,000 requests/hour
# GITHUB_TOKEN=

# ---- Standalone server
# PORT=3000
# DATA_DIR=./.data
